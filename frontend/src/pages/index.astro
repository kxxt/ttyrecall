---
import "asciinema-player/dist/bundle/asciinema-player.css";
import "../styles/app.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ttyrecall</title>
  </head>
  <body>
    <header>
      <h1>ttyrecall</h1>
      <div class="header-actions">
        <button id="themeToggle" class="secondary icon-button" type="button" aria-label="Theme" title="Theme">
          <i data-lucide="monitor-cog" aria-hidden="true"></i>
        </button>
        <div class="user" id="userLabel"></div>
      </div>
    </header>

    <div id="loginPanel" class="login card">
      <h2>Sign in</h2>
      <div>
        <label for="username">Username</label>
        <input id="username" autocomplete="username" />
      </div>
      <div style="margin-top: 12px;">
        <label for="password">Password</label>
        <input id="password" type="password" autocomplete="current-password" />
      </div>
      <div style="margin-top: 16px;">
        <button id="loginButton" class="command-button">
          <i data-lucide="log-in" aria-hidden="true"></i>
          <span>Login</span>
        </button>
      </div>
      <div id="loginError" class="muted" style="margin-top: 12px;"></div>
    </div>

    <main id="appPanel" class="hidden">
      <div class="grid">
        <div class="card">
          <h2>Activity</h2>
          <div class="heatmap-scroll">
            <div id="heatmapLabels" class="heatmap-labels"></div>
            <div id="heatmap" class="heatmap"></div>
          </div>
          <div id="heatmapFilter" class="heatmap-filter muted"></div>
          <div class="legend">
            <span style="background: var(--heat-0);"></span> 0
            <span style="background: var(--heat-1);"></span> 1-2
            <span style="background: var(--heat-2);"></span> 3-5
            <span style="background: var(--heat-3);"></span> 6-9
            <span style="background: var(--heat-4);"></span> 10+
          </div>
        </div>
        <div class="card">
          <h2>Bulk Actions</h2>
          <div class="actions">
            <button id="refreshButton" class="secondary icon-button" aria-label="Refresh" title="Refresh">
              <i data-lucide="refresh-cw" aria-hidden="true"></i>
            </button>
            <button id="downloadButton" class="icon-button" aria-label="Download selected" title="Download selected">
              <i data-lucide="download" aria-hidden="true"></i>
            </button>
            <button id="deleteButton" class="secondary icon-button danger" aria-label="Delete selected" title="Delete selected">
              <i data-lucide="trash-2" aria-hidden="true"></i>
            </button>
            <button id="logoutButton" class="secondary icon-button" aria-label="Logout" title="Logout">
              <i data-lucide="log-out" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </div>

      <div class="card" style="margin-top: 20px;">
        <div class="recordings-header">
          <h2>Recordings</h2>
          <div class="view-toggle">
            <label class="select-all-toggle hidden" id="selectAllGalleryWrap">
              <input type="checkbox" id="selectAllGallery" />
              Select All
            </label>
            <button id="viewList" class="secondary icon-button" type="button" aria-label="List view" title="List view">
              <i data-lucide="list" aria-hidden="true"></i>
            </button>
            <button id="viewGallery" class="secondary icon-button" type="button" aria-label="Gallery view" title="Gallery view">
              <i data-lucide="layout-grid" aria-hidden="true"></i>
            </button>
          </div>
        </div>
        <div id="listView" style="overflow-x: auto;">
          <table>
            <thead>
              <tr>
                <th><input type="checkbox" id="selectAll" /></th>
                <th>Date</th>
                <th>Name</th>
                <th>Size</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="recordingsBody"></tbody>
          </table>
        </div>
        <div id="galleryView" class="gallery hidden"></div>
        <div id="emptyState" class="empty hidden">No recordings found.</div>
      </div>
    </main>

    <script src="../scripts/app.js"></script>
  </body>
</html>
