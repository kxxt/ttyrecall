---
import "asciinema-player/dist/bundle/asciinema-player.css";
import "../styles/view.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ttyrecall viewer</title>
  </head>
  <body>
    <header>
      <a href="/">Back</a>
      <div id="title">Recording</div>
      <div class="header-actions">
        <button id="themeToggle" class="secondary" type="button">Theme</button>
      </div>
    </header>
    <div id="player"></div>
    <div id="fallback" class="fallback hidden">
      Player failed to load. You can still <a id="downloadLink" href="#">download the recording</a>.
    </div>

    <script src="../scripts/view.js"></script>
  </body>
</html>
